# Puts the frontend and backend on a single origin. That removes CORS and
# third-party-cookie concerns, and lets one prebuilt frontend image serve any
# domain, because the browser calls `/api/*` relative to wherever it is loaded.
{
	admin off
	auto_https off
}

:8080 {
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Public short links for dynamic codes. These are what printed QR codes
	# actually encode, so they must reach the backend rather than the frontend
	# app, and must sit above the catch-all below.
	handle /r/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:3001
	}
}
