# Copy this file to `.env` and fill it in:  cp .env.example .env
#
# `.env` is gitignored. It is read by two different things:
#   - local development, via `dotenv -e .env` in each app's `dev` script
#   - `docker compose`, which picks up `.env` from the repo root automatically
# Keep it up to date when you add a variable, and never put real secrets here.

# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# Generate one with: openssl rand -base64 32
# Must be at least 32 characters. Required when NODE_ENV=production.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Local development (pnpm dev)
# ---------------------------------------------------------------------------
# Matches the Postgres published by `docker compose -f docker-compose.dev.yml up -d`.
POSTGRES_URL="postgres://postgres:postgres@localhost:5432/qr_manager"

# Public origins of the two apps while developing on the host.
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
# The browser bundle needs an absolute URL in dev, because the apps are on
# different ports and nothing is proxying between them.
VITE_BACKEND_URL="http://localhost:3000"

# Interface and port the BACKEND binds to. HOST=0.0.0.0 makes it reachable
# from outside a container.
#
# `PORT` is backend-only here, but both apps load this file, and the frontend's
# dev server (nitro) reads PORT too. `vite.config.ts` pins the frontend to
# FRONTEND_PORT so the two cannot collide -- change FRONTEND_PORT, not PORT, to
# move the frontend. If you change PORT, update BACKEND_URL/VITE_BACKEND_URL too.
HOST="0.0.0.0"
PORT="3000"
FRONTEND_PORT="3001"

# ---------------------------------------------------------------------------
# Docker Compose (docker compose up)
# ---------------------------------------------------------------------------
# The single public origin the whole stack is served from. Change this to your
# real domain when self-hosting, e.g. https://qr.example.com
PUBLIC_URL="http://localhost:8080"
PUBLIC_PORT="8080"

# Credentials for the bundled Postgres container.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="qr_manager"

# NOTE: Compose sets POSTGRES_URL, BACKEND_URL and FRONTEND_URL itself from the
# values above, so the development values further up are ignored there.
# Leave VITE_BACKEND_URL empty for Compose: the proxy puts the backend on the
# same origin, which is what keeps the frontend image portable across domains.

# ---------------------------------------------------------------------------
# Optional: who may create an account
# ---------------------------------------------------------------------------
# Off by default, so an instance on a public URL does not accept strangers.
# The FIRST account is always allowed regardless -- a fresh deployment sends
# you to /setup to create it, and it becomes the admin -- so turning this off
# cannot lock you out. With it off, further accounts are added from
# Administration -> Users while signed in as an admin.
ALLOW_REGISTRATION="false"

# ---------------------------------------------------------------------------
# Optional: Discord OAuth. Leave blank to disable the provider entirely.
# @see https://www.better-auth.com/docs/authentication/discord
# ---------------------------------------------------------------------------
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
